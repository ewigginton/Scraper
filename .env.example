# Airtable
AIRTABLE_LAND_TOKEN=pat_XXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Email
EMAIL_TO=emma@classiccountryland.com

# SMTP delivery (strongly recommended — without it, email falls back to the
# local macOS `mail` command, which usually cannot deliver off the machine).
# For Gmail: smtp.gmail.com / 587 with an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dead-man's-switch monitoring (recommended): create a free check at
# https://healthchecks.io and paste its ping URL here. The scraper pings it
# after every run; if the machine sleeps through a night or the job breaks,
# healthchecks.io emails you about the MISSING ping.
HEALTHCHECK_URL=

# Optional: write the emailed report to a file as well
SCRAPER_REPORT_FILE=

# Browser fallback for bot-blocked sites (LandWatch/Land.com/LandAndFarm
# answer 403 to plain HTTP clients). Uses the machine's installed Google
# Chrome automatically. Set a path only if Chrome lives somewhere unusual;
# set SCRAPER_BROWSER_FALLBACK=false to turn the fallback off entirely.
SCRAPER_BROWSER_PATH=
SCRAPER_BROWSER_FALLBACK=

# Optional
REGRID_API_TOKEN=
