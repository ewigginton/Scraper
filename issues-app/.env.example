# Database connection — the Hub's .env.local from Scott replaces this at deployment.
# Must authenticate as the `issues_app` role (nosuperuser, nobypassrls — see
# supabase/migrations/20260731090700_issues_app_role_grants.sql), never the
# migration-owner/superuser role: a superuser/BYPASSRLS connection silently
# disables every RLS policy in this schema. app/api/health checks this.
DATABASE_URL=postgresql://user:password@localhost:5432/issues-app

# Controls whether lib/auth/current-user.ts's development-only auth stub is
# allowed to run outside NODE_ENV=development (including when NODE_ENV is
# unset). Leave unset/false everywhere except an explicitly unauthenticated
# demo/review deployment — when set, every visitor is authenticated as a
# hardcoded 'dev-user' with the coordinator role, with no login of any kind.
# NEVER set this in a real production deployment.
ISSUES_ALLOW_AUTH_STUB=false

# Runs the app against an embedded, persisted PGlite database at .demo-db/
# (built by `npm run demo` / scripts/demo-seed.ts) instead of DATABASE_URL —
# zero-setup local demo/review only. Checked by lib/db/client.ts (getDb's
# demo branch) and app/api/health (labels the response mode:'demo' and
# skips the RLS-bypass assertion, since PGlite has only a superuser role).
# NEVER set this in a real production deployment.
ISSUES_DEMO=

# Optional shared secret gating the DETAILED /api/health response (raw
# reason text, rolsuper/rolbypassrls). The route has no other auth of any
# kind — leaving this unset is safe (detail is withheld from everyone,
# fails closed) but means operators only get a bare ok/not-ok liveness
# answer. Set it and pass the same value as the `x-health-token` request
# header to see the detailed diagnostic.
ISSUES_HEALTH_TOKEN=

# IANA timezone lib/date/business-today.ts resolves "today" in for every
# due-date/overdue/aging calculation (personal work screen, dashboard,
# exceptions queues, /issues overdueOnly filter). Defaults to
# America/Chicago if unset.
ISSUES_BUSINESS_TZ=America/Chicago
